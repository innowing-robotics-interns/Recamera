# reCamera Network & Connection Settings
RECAMERA_IP=192.168.42.1

# Supervisor REST API (Port 80)
RECAMERA_API_PORT=80
RECAMERA_USERNAME=recamera
RECAMERA_PASSWORD=recamera

# RTSP Video Stream (Port 554)
RECAMERA_RTSP_PORT=554
RECAMERA_RTSP_PATH=/live
RECAMERA_RTSP_USER=admin
RECAMERA_RTSP_PASS=admin

# Node-RED WebSocket Detections Stream (Port 1880)
RECAMERA_WS_PORT=1880
RECAMERA_WS_PATH=/ws/boxes
