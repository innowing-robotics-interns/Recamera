# reCamera network and connection settings.
# Copy to .env and adjust; .env is gitignored.

# Camera address (USB default 192.168.42.1, or its Wi-Fi IP)
RECAMERA_IP=192.168.42.1

# Supervisor REST API
RECAMERA_API_PORT=80
RECAMERA_USERNAME=recamera
RECAMERA_PASSWORD=recamera

# RTSP video stream
RECAMERA_RTSP_PORT=554
RECAMERA_RTSP_PATH=/live
RECAMERA_RTSP_USER=admin
RECAMERA_RTSP_PASS=admin

# Node-RED admin + detection websocket
RECAMERA_NODERED_PORT=1880
RECAMERA_WS_PORT=1880
RECAMERA_WS_PATH=/ws/boxes

# Pixel space of the boxes published on /ws/boxes (the model node's preview
# resolution; 1280x720 on firmware 0.2.4). Used when a payload omits
# "resolution", so boxes scale onto the 1920x1080 RTSP frame.
RECAMERA_PREVIEW_WIDTH=1280
RECAMERA_PREVIEW_HEIGHT=720

# Optional: override where bundled models and backups live.
# RECAMERA_MODELS_DIR=./models
# RECAMERA_BACKUP_DIR=./backups
